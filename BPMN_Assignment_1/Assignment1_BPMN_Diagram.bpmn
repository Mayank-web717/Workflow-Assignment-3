<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://bpmn.io/schema/bpmn"
             exporter="BPMN Assignment Generator"
             exporterVersion="1.0">

  <!-- ============================================================ -->
  <!-- ASSIGNMENT 1: Student Project Approval and Allocation System -->
  <!-- ============================================================ -->

  <collaboration id="Collaboration_Assignment1">
    <participant id="Pool_SPAS" name="Student Project Approval and Allocation System" processRef="Process_SPAS" />
  </collaboration>

  <process id="Process_SPAS" name="Student Project Approval and Allocation System" isExecutable="true">

    <laneSet id="LaneSet_SPAS">
      <lane id="Lane_Student" name="Student / Team">
        <flowNodeRef>StartEvent_SubmitProposal</flowNodeRef>
        <flowNodeRef>Task_PrepareProposal</flowNodeRef>
        <flowNodeRef>BoundaryTimer_Deadline</flowNodeRef>
        <flowNodeRef>IntermediateCatch_RevisionRequest</flowNodeRef>
        <flowNodeRef>Task_ReviseProposal</flowNodeRef>
        <flowNodeRef>GW_ReviseOrWithdraw</flowNodeRef>
        <flowNodeRef>Task_WithdrawProposal</flowNodeRef>
        <flowNodeRef>Task_AcknowledgeAllocation</flowNodeRef>
        <flowNodeRef>EndEvent_StudentNotified</flowNodeRef>
        <flowNodeRef>EndEvent_Withdrawn</flowNodeRef>
        <flowNodeRef>EndEvent_Lapsed</flowNodeRef>
      </lane>
      <lane id="Lane_Coordinator" name="Project Coordinator">
        <flowNodeRef>Task_ScreenProposal</flowNodeRef>
        <flowNodeRef>GW_ScreeningPass</flowNodeRef>
        <flowNodeRef>Task_ReturnInvalid</flowNodeRef>
        <flowNodeRef>Task_EscalateDelay</flowNodeRef>
        <flowNodeRef>Task_ManualGuideAllocation</flowNodeRef>
        <flowNodeRef>EndEvent_InvalidTeam</flowNodeRef>
        <flowNodeRef>EndEvent_NoGuide</flowNodeRef>
      </lane>
      <lane id="Lane_System" name="Project Management System">
        <flowNodeRef>Task_ValidateCompleteness</flowNodeRef>
        <flowNodeRef>GW_CompletenessOK</flowNodeRef>
        <flowNodeRef>Task_ValidateTeamRules</flowNodeRef>
        <flowNodeRef>GW_TeamRulesOK</flowNodeRef>
        <flowNodeRef>Task_SimilarityCheck</flowNodeRef>
        <flowNodeRef>GW_SimilarityOK</flowNodeRef>
        <flowNodeRef>Task_AllocateGuide</flowNodeRef>
        <flowNodeRef>Task_SendAllocationRequest</flowNodeRef>
        <flowNodeRef>BoundaryTimer_GuideTimeout</flowNodeRef>
        <flowNodeRef>GW_GuideResponse</flowNodeRef>
        <flowNodeRef>IntermediateCatch_GuideAccept</flowNodeRef>
        <flowNodeRef>Task_RecordAllocation</flowNodeRef>
        <flowNodeRef>Task_NotifyStudent</flowNodeRef>
        <flowNodeRef>BoundaryError_NotifyFail</flowNodeRef>
        <flowNodeRef>Task_LogWithdrawal</flowNodeRef>
        <flowNodeRef>EndEvent_SystemFailure</flowNodeRef>
        <flowNodeRef>EndEvent_Duplicate</flowNodeRef>
      </lane>
      <lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <flowNodeRef>Task_EvaluateProposal</flowNodeRef>
        <flowNodeRef>GW_CommitteeDecision</flowNodeRef>
        <flowNodeRef>Task_SendRevisionRequest</flowNodeRef>
        <flowNodeRef>BoundaryTimer_ReviewDelay</flowNodeRef>
        <flowNodeRef>EndEvent_Rejected</flowNodeRef>
      </lane>
      <lane id="Lane_Guide" name="Faculty Guide">
        <flowNodeRef>Task_CheckGuideAvailability</flowNodeRef>
        <flowNodeRef>GW_GuideAvailable</flowNodeRef>
      </lane>
    </laneSet>

    <!-- ========== START EVENT ========== -->
    <startEvent id="StartEvent_SubmitProposal" name="Student Team Decides to Submit Proposal">
      <outgoing>SF_Start_Prepare</outgoing>
    </startEvent>

    <!-- ========== STUDENT LANE ========== -->
    <userTask id="Task_PrepareProposal" name="Prepare and Submit Project Proposal">
      <incoming>SF_Start_Prepare</incoming>
      <outgoing>SF_Prepare_Validate</outgoing>
    </userTask>

    <boundaryEvent id="BoundaryTimer_Deadline" name="Submission Deadline Expired (F4 - 14 Days)" attachedToRef="Task_PrepareProposal" cancelActivity="true">
      <outgoing>SF_Deadline_Lapsed</outgoing>
      <timerEventDefinition id="TimerDef_Deadline">
        <timeDuration>P14D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <intermediateCatchEvent id="IntermediateCatch_RevisionRequest" name="Receive Revision Request from Committee (F5)">
      <incoming>SF_SendRevision_Catch</incoming>
      <outgoing>SF_Catch_Revise</outgoing>
      <messageEventDefinition id="MsgDef_RevisionReq" messageRef="Msg_RevisionRequest" />
    </intermediateCatchEvent>

    <userTask id="Task_ReviseProposal" name="Revise Proposal per Committee Feedback (F5)">
      <incoming>SF_Catch_Revise</incoming>
      <outgoing>SF_Revise_GW</outgoing>
    </userTask>

    <exclusiveGateway id="GW_ReviseOrWithdraw" name="Proceed with Revision or Withdraw?">
      <incoming>SF_Revise_GW</incoming>
      <outgoing>SF_ReviseOK_Similarity</outgoing>
      <outgoing>SF_Withdraw</outgoing>
    </exclusiveGateway>

    <userTask id="Task_WithdrawProposal" name="Submit Withdrawal Notice (F11)">
      <incoming>SF_Withdraw</incoming>
      <outgoing>SF_Withdraw_Log</outgoing>
    </userTask>

    <userTask id="Task_AcknowledgeAllocation" name="Acknowledge Guide Allocation Notification">
      <incoming>SF_Notify_Acknowledge</incoming>
      <outgoing>SF_Acknowledge_Success</outgoing>
    </userTask>

    <endEvent id="EndEvent_StudentNotified" name="Guide Allocated and Student Notified - SUCCESS">
      <incoming>SF_Acknowledge_Success</incoming>
    </endEvent>

    <endEvent id="EndEvent_Withdrawn" name="Process Ended - Proposal Withdrawn (F11)">
      <incoming>SF_Log_EndWithdrawn</incoming>
    </endEvent>

    <endEvent id="EndEvent_Lapsed" name="Process Ended - Proposal Lapsed (F4)">
      <incoming>SF_Deadline_Lapsed</incoming>
    </endEvent>

    <!-- ========== SYSTEM LANE ========== -->
    <serviceTask id="Task_ValidateCompleteness" name="Validate Document Completeness (F1)">
      <incoming>SF_Prepare_Validate</incoming>
      <outgoing>SF_Validate_GW1</outgoing>
    </serviceTask>

    <exclusiveGateway id="GW_CompletenessOK" name="Documents Complete?">
      <incoming>SF_Validate_GW1</incoming>
      <outgoing>SF_Complete_TeamRules</outgoing>
      <outgoing>SF_Incomplete_Return</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_ValidateTeamRules" name="Validate Team Composition Rules (F2)">
      <incoming>SF_Complete_TeamRules</incoming>
      <outgoing>SF_TeamRules_GW</outgoing>
    </serviceTask>

    <exclusiveGateway id="GW_TeamRulesOK" name="Team Rules Satisfied?">
      <incoming>SF_TeamRules_GW</incoming>
      <outgoing>SF_TeamOK_Screen</outgoing>
      <outgoing>SF_TeamFail_Return</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_SimilarityCheck" name="Run Similarity and Duplicate Topic Check (F3)">
      <incoming>SF_ScreenOK_Similarity</incoming>
      <incoming>SF_ReviseOK_Similarity</incoming>
      <outgoing>SF_Similarity_GW</outgoing>
    </serviceTask>

    <exclusiveGateway id="GW_SimilarityOK" name="Topic Unique? (F3)">
      <incoming>SF_Similarity_GW</incoming>
      <outgoing>SF_Unique_Committee</outgoing>
      <outgoing>SF_Duplicate_End</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_AllocateGuide" name="Auto-Allocate Guide via Business Rules (F8)">
      <incoming>SF_GuideAvail_Allocate</incoming>
      <outgoing>SF_Alloc_Send</outgoing>
    </serviceTask>

    <sendTask id="Task_SendAllocationRequest" name="Send Guide Allocation Request (F9)">
      <incoming>SF_Alloc_Send</incoming>
      <outgoing>SF_Send_GWResponse</outgoing>
    </sendTask>

    <boundaryEvent id="BoundaryTimer_GuideTimeout" name="Guide Response Timeout - 3 Days (F9)" attachedToRef="Task_SendAllocationRequest" cancelActivity="false">
      <outgoing>SF_GuideTimeout_Manual</outgoing>
      <timerEventDefinition id="TimerDef_GuideTimeout">
        <timeDuration>P3D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <eventBasedGateway id="GW_GuideResponse" name="Awaiting Guide Response (F9)">
      <incoming>SF_Send_GWResponse</incoming>
      <outgoing>SF_GWResponse_Accept</outgoing>
      <outgoing>SF_GWResponse_Timeout</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="IntermediateCatch_GuideAccept" name="Guide Accepts Allocation">
      <incoming>SF_GWResponse_Accept</incoming>
      <outgoing>SF_GuideAccept_Record</outgoing>
      <messageEventDefinition id="MsgDef_GuideAccept" messageRef="Msg_GuideAccepted" />
    </intermediateCatchEvent>

    <serviceTask id="Task_RecordAllocation" name="Record Guide Allocation in System">
      <incoming>SF_GuideAccept_Record</incoming>
      <incoming>SF_ManualAlloc_Record</incoming>
      <outgoing>SF_Record_Notify</outgoing>
    </serviceTask>

    <sendTask id="Task_NotifyStudent" name="Send Allocation Notification to Student (F10)">
      <incoming>SF_Record_Notify</incoming>
      <outgoing>SF_Notify_Acknowledge</outgoing>
    </sendTask>

    <boundaryEvent id="BoundaryError_NotifyFail" name="Notification System Failure (F10)" attachedToRef="Task_NotifyStudent" cancelActivity="false">
      <outgoing>SF_NotifyFail_SysEnd</outgoing>
      <errorEventDefinition id="ErrCatch_NotifyFail" errorRef="Err_SystemFailure" />
    </boundaryEvent>

    <scriptTask id="Task_LogWithdrawal" name="Log Withdrawal and Trigger Compensation (F11)" scriptFormat="groovy">
      <incoming>SF_Withdraw_Log</incoming>
      <outgoing>SF_Log_EndWithdrawn</outgoing>
    </scriptTask>

    <endEvent id="EndEvent_SystemFailure" name="Process Ended - System Failure Requires Manual Recovery (F10)">
      <incoming>SF_NotifyFail_SysEnd</incoming>
      <errorEventDefinition id="ErrDef_SysEnd" errorRef="Err_SystemFailure" />
    </endEvent>

    <endEvent id="EndEvent_Duplicate" name="Process Ended - Duplicate or Plagiarised Topic (F3)">
      <incoming>SF_Duplicate_End</incoming>
    </endEvent>

    <!-- ========== COORDINATOR LANE ========== -->
    <userTask id="Task_ScreenProposal" name="Screen Proposal for Eligibility and Completeness">
      <incoming>SF_TeamOK_Screen</incoming>
      <outgoing>SF_Screen_GW</outgoing>
    </userTask>

    <exclusiveGateway id="GW_ScreeningPass" name="Screening Passed?">
      <incoming>SF_Screen_GW</incoming>
      <outgoing>SF_ScreenOK_Similarity</outgoing>
      <outgoing>SF_ScreenFail_Return</outgoing>
    </exclusiveGateway>

    <userTask id="Task_ReturnInvalid" name="Return Proposal as Invalid and Notify Student (F1/F2)">
      <incoming>SF_Incomplete_Return</incoming>
      <incoming>SF_TeamFail_Return</incoming>
      <incoming>SF_ScreenFail_Return</incoming>
      <outgoing>SF_Return_EndInvalid</outgoing>
    </userTask>

    <userTask id="Task_EscalateDelay" name="Escalate Review Delay to HoD (F7)">
      <incoming>SF_ReviewDelay_Escalate</incoming>
      <outgoing>SF_Escalate_ReEval</outgoing>
    </userTask>

    <userTask id="Task_ManualGuideAllocation" name="Manually Assign Available Guide (F8 Fallback)">
      <incoming>SF_NoGuide_Manual</incoming>
      <incoming>SF_GuideTimeout_Manual</incoming>
      <incoming>SF_GWResponse_Timeout</incoming>
      <outgoing>SF_ManualAlloc_GW</outgoing>
    </userTask>

    <exclusiveGateway id="GW_ManualAllocResult" name="Manual Allocation Successful?">
      <incoming>SF_ManualAlloc_GW</incoming>
      <outgoing>SF_ManualAlloc_Record</outgoing>
      <outgoing>SF_ManualFail_EndNoGuide</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_InvalidTeam" name="Process Ended - Invalid Proposal (F1/F2)">
      <incoming>SF_Return_EndInvalid</incoming>
    </endEvent>

    <endEvent id="EndEvent_NoGuide" name="Process Ended - No Guide Available After All Attempts (F8)">
      <incoming>SF_ManualFail_EndNoGuide</incoming>
    </endEvent>

    <!-- ========== COMMITTEE LANE ========== -->
    <userTask id="Task_EvaluateProposal" name="Evaluate Project Proposal (Committee Full Review)">
      <incoming>SF_Unique_Committee</incoming>
      <incoming>SF_Escalate_ReEval</incoming>
      <outgoing>SF_Evaluate_Decision</outgoing>
    </userTask>

    <boundaryEvent id="BoundaryTimer_ReviewDelay" name="Review SLA Exceeded - 10 Days (F7)" attachedToRef="Task_EvaluateProposal" cancelActivity="false">
      <outgoing>SF_ReviewDelay_Escalate</outgoing>
      <timerEventDefinition id="TimerDef_ReviewDelay">
        <timeDuration>P10D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <exclusiveGateway id="GW_CommitteeDecision" name="Committee Decision: Approve / Revise / Reject?">
      <incoming>SF_Evaluate_Decision</incoming>
      <outgoing>SF_Approve_GuideCheck</outgoing>
      <outgoing>SF_Revise_SendRequest</outgoing>
      <outgoing>SF_Reject_End</outgoing>
    </exclusiveGateway>

    <sendTask id="Task_SendRevisionRequest" name="Send Revision Feedback to Student (F5)">
      <incoming>SF_Revise_SendRequest</incoming>
      <outgoing>SF_SendRevision_Catch</outgoing>
    </sendTask>

    <endEvent id="EndEvent_Rejected" name="Process Ended - Proposal Rejected by Committee (F6)">
      <incoming>SF_Reject_End</incoming>
    </endEvent>

    <!-- ========== GUIDE LANE ========== -->
    <businessRuleTask id="Task_CheckGuideAvailability" name="Check Guide Availability Workload and Domain Match (Business Rules)">
      <incoming>SF_Approve_GuideCheck</incoming>
      <outgoing>SF_GuideCheck_GW</outgoing>
    </businessRuleTask>

    <exclusiveGateway id="GW_GuideAvailable" name="Suitable Guide Found? (F8)">
      <incoming>SF_GuideCheck_GW</incoming>
      <outgoing>SF_GuideAvail_Allocate</outgoing>
      <outgoing>SF_NoGuide_Manual</outgoing>
    </exclusiveGateway>

    <!-- ========== SEQUENCE FLOWS ========== -->
    <!-- Start -->
    <sequenceFlow id="SF_Start_Prepare" sourceRef="StartEvent_SubmitProposal" targetRef="Task_PrepareProposal" />
    <sequenceFlow id="SF_Prepare_Validate" sourceRef="Task_PrepareProposal" targetRef="Task_ValidateCompleteness" />

    <!-- F4 Deadline -->
    <sequenceFlow id="SF_Deadline_Lapsed" name="Deadline Expired (F4)" sourceRef="BoundaryTimer_Deadline" targetRef="EndEvent_Lapsed" />

    <!-- Validation -->
    <sequenceFlow id="SF_Validate_GW1" sourceRef="Task_ValidateCompleteness" targetRef="GW_CompletenessOK" />
    <sequenceFlow id="SF_Complete_TeamRules" name="Complete" sourceRef="GW_CompletenessOK" targetRef="Task_ValidateTeamRules" />
    <sequenceFlow id="SF_Incomplete_Return" name="Incomplete (F1)" sourceRef="GW_CompletenessOK" targetRef="Task_ReturnInvalid" />
    <sequenceFlow id="SF_TeamRules_GW" sourceRef="Task_ValidateTeamRules" targetRef="GW_TeamRulesOK" />
    <sequenceFlow id="SF_TeamOK_Screen" name="Valid" sourceRef="GW_TeamRulesOK" targetRef="Task_ScreenProposal" />
    <sequenceFlow id="SF_TeamFail_Return" name="Invalid Team (F2)" sourceRef="GW_TeamRulesOK" targetRef="Task_ReturnInvalid" />

    <!-- Screening -->
    <sequenceFlow id="SF_Screen_GW" sourceRef="Task_ScreenProposal" targetRef="GW_ScreeningPass" />
    <sequenceFlow id="SF_ScreenOK_Similarity" name="Passed" sourceRef="GW_ScreeningPass" targetRef="Task_SimilarityCheck" />
    <sequenceFlow id="SF_ScreenFail_Return" name="Failed Screening" sourceRef="GW_ScreeningPass" targetRef="Task_ReturnInvalid" />

    <!-- Return to Invalid End -->
    <sequenceFlow id="SF_Return_EndInvalid" sourceRef="Task_ReturnInvalid" targetRef="EndEvent_InvalidTeam" />

    <!-- Similarity -->
    <sequenceFlow id="SF_Similarity_GW" sourceRef="Task_SimilarityCheck" targetRef="GW_SimilarityOK" />
    <sequenceFlow id="SF_Unique_Committee" name="Unique Topic" sourceRef="GW_SimilarityOK" targetRef="Task_EvaluateProposal" />
    <sequenceFlow id="SF_Duplicate_End" name="Duplicate / Plagiarised (F3)" sourceRef="GW_SimilarityOK" targetRef="EndEvent_Duplicate" />

    <!-- Committee Review -->
    <sequenceFlow id="SF_Evaluate_Decision" sourceRef="Task_EvaluateProposal" targetRef="GW_CommitteeDecision" />
    <sequenceFlow id="SF_ReviewDelay_Escalate" name="SLA Exceeded (F7)" sourceRef="BoundaryTimer_ReviewDelay" targetRef="Task_EscalateDelay" />
    <sequenceFlow id="SF_Escalate_ReEval" name="HoD Orders Re-evaluation" sourceRef="Task_EscalateDelay" targetRef="Task_EvaluateProposal" />
    <sequenceFlow id="SF_Approve_GuideCheck" name="Approved" sourceRef="GW_CommitteeDecision" targetRef="Task_CheckGuideAvailability" />
    <sequenceFlow id="SF_Revise_SendRequest" name="Requires Revision (F5)" sourceRef="GW_CommitteeDecision" targetRef="Task_SendRevisionRequest" />
    <sequenceFlow id="SF_Reject_End" name="Rejected (F6)" sourceRef="GW_CommitteeDecision" targetRef="EndEvent_Rejected" />

    <!-- Revision Loop -->
    <sequenceFlow id="SF_SendRevision_Catch" sourceRef="Task_SendRevisionRequest" targetRef="IntermediateCatch_RevisionRequest" />
    <sequenceFlow id="SF_Catch_Revise" sourceRef="IntermediateCatch_RevisionRequest" targetRef="Task_ReviseProposal" />
    <sequenceFlow id="SF_Revise_GW" sourceRef="Task_ReviseProposal" targetRef="GW_ReviseOrWithdraw" />
    <sequenceFlow id="SF_ReviseOK_Similarity" name="Proceed with Revised Proposal" sourceRef="GW_ReviseOrWithdraw" targetRef="Task_SimilarityCheck" />
    <sequenceFlow id="SF_Withdraw" name="Withdraw (F11)" sourceRef="GW_ReviseOrWithdraw" targetRef="Task_WithdrawProposal" />
    <sequenceFlow id="SF_Withdraw_Log" sourceRef="Task_WithdrawProposal" targetRef="Task_LogWithdrawal" />
    <sequenceFlow id="SF_Log_EndWithdrawn" sourceRef="Task_LogWithdrawal" targetRef="EndEvent_Withdrawn" />

    <!-- Guide Check -->
    <sequenceFlow id="SF_GuideCheck_GW" sourceRef="Task_CheckGuideAvailability" targetRef="GW_GuideAvailable" />
    <sequenceFlow id="SF_GuideAvail_Allocate" name="Guide Available" sourceRef="GW_GuideAvailable" targetRef="Task_AllocateGuide" />
    <sequenceFlow id="SF_NoGuide_Manual" name="No Guide Available (F8)" sourceRef="GW_GuideAvailable" targetRef="Task_ManualGuideAllocation" />

    <!-- Guide Allocation -->
    <sequenceFlow id="SF_Alloc_Send" sourceRef="Task_AllocateGuide" targetRef="Task_SendAllocationRequest" />
    <sequenceFlow id="SF_Send_GWResponse" sourceRef="Task_SendAllocationRequest" targetRef="GW_GuideResponse" />
    <sequenceFlow id="SF_GWResponse_Accept" name="Guide Accepts" sourceRef="GW_GuideResponse" targetRef="IntermediateCatch_GuideAccept" />
    <sequenceFlow id="SF_GWResponse_Timeout" name="No Response (F9)" sourceRef="GW_GuideResponse" targetRef="Task_ManualGuideAllocation" />
    <sequenceFlow id="SF_GuideTimeout_Manual" name="Guide Silent - Timeout (F9)" sourceRef="BoundaryTimer_GuideTimeout" targetRef="Task_ManualGuideAllocation" />
    <sequenceFlow id="SF_GuideAccept_Record" sourceRef="IntermediateCatch_GuideAccept" targetRef="Task_RecordAllocation" />

    <!-- Manual Allocation Path -->
    <sequenceFlow id="SF_ManualAlloc_GW" sourceRef="Task_ManualGuideAllocation" targetRef="GW_ManualAllocResult" />
    <sequenceFlow id="SF_ManualAlloc_Record" name="Manual Allocation OK" sourceRef="GW_ManualAllocResult" targetRef="Task_RecordAllocation" />
    <sequenceFlow id="SF_ManualFail_EndNoGuide" name="No Guide Found (F8)" sourceRef="GW_ManualAllocResult" targetRef="EndEvent_NoGuide" />

    <!-- Notification and Closure -->
    <sequenceFlow id="SF_Record_Notify" sourceRef="Task_RecordAllocation" targetRef="Task_NotifyStudent" />
    <sequenceFlow id="SF_Notify_Acknowledge" sourceRef="Task_NotifyStudent" targetRef="Task_AcknowledgeAllocation" />
    <sequenceFlow id="SF_NotifyFail_SysEnd" name="Notification Failure (F10)" sourceRef="BoundaryError_NotifyFail" targetRef="EndEvent_SystemFailure" />
    <sequenceFlow id="SF_Acknowledge_Success" sourceRef="Task_AcknowledgeAllocation" targetRef="EndEvent_StudentNotified" />

  </process>

  <!-- Messages -->
  <message id="Msg_RevisionRequest" name="RevisionRequest" />
  <message id="Msg_GuideAccepted" name="GuideAccepted" />

  <!-- Errors -->
  <error id="Err_SystemFailure" name="SystemFailureError" errorCode="SYS_FAILURE" />

  <!-- ==================== BPMN DI ==================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_A1">
    <bpmndi:BPMNPlane id="BPMNPlane_A1" bpmnElement="Collaboration_Assignment1">

      <!-- Pool -->
      <bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_SPAS" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="2500" height="1000" />
      </bpmndi:BPMNShape>

      <!-- Lane Student -->
      <bpmndi:BPMNShape id="Shape_Lane_Student" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="130" y="40" width="2470" height="180" />
      </bpmndi:BPMNShape>
      <!-- Lane Coordinator -->
      <bpmndi:BPMNShape id="Shape_Lane_Coord" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="130" y="220" width="2470" height="180" />
      </bpmndi:BPMNShape>
      <!-- Lane System -->
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="400" width="2470" height="200" />
      </bpmndi:BPMNShape>
      <!-- Lane Committee -->
      <bpmndi:BPMNShape id="Shape_Lane_Committee" bpmnElement="Lane_Committee" isHorizontal="true">
        <dc:Bounds x="130" y="600" width="2470" height="180" />
      </bpmndi:BPMNShape>
      <!-- Lane Guide -->
      <bpmndi:BPMNShape id="Shape_Lane_Guide" bpmnElement="Lane_Guide" isHorizontal="true">
        <dc:Bounds x="130" y="780" width="2470" height="260" />
      </bpmndi:BPMNShape>

      <!-- START -->
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_SubmitProposal">
        <dc:Bounds x="182" y="111" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="160" y="154" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Student Lane shapes -->
      <bpmndi:BPMNShape id="Shape_PrepareProposal" bpmnElement="Task_PrepareProposal">
        <dc:Bounds x="268" y="89" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BTimer_Deadline" bpmnElement="BoundaryTimer_Deadline">
        <dc:Bounds x="320" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="300" y="193" width="76" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RevisionCatch" bpmnElement="IntermediateCatch_RevisionRequest">
        <dc:Bounds x="1068" y="111" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1044" y="154" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Revise" bpmnElement="Task_ReviseProposal">
        <dc:Bounds x="1158" y="89" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_ReviseOrWith" bpmnElement="GW_ReviseOrWithdraw" isMarkerVisible="true">
        <dc:Bounds x="1358" y="104" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1328" y="159" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Withdraw" bpmnElement="Task_WithdrawProposal">
        <dc:Bounds x="1458" y="89" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Acknowledge" bpmnElement="Task_AcknowledgeAllocation">
        <dc:Bounds x="2268" y="89" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndSuccess" bpmnElement="EndEvent_StudentNotified">
        <dc:Bounds x="2468" y="111" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2443" y="154" width="86" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndWithdrawn" bpmnElement="EndEvent_Withdrawn">
